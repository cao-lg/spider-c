{
  "name": "crawler-course",
  "type": "module",
  "version": "2.0.0",
  "description": "爬虫学堂 —— 目标—活动—评价一致的 Python 爬虫课程站(浏览器内 Pyodide 实战)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "npm run check",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "node scripts/check-catalog.ts",
    "test": "node --test tests/unit/*.test.ts",
    "test:e2e": "python tests/e2e/run_all.py",
    "archive:weekly": "node scripts/archive-weekly.ts",
    "verify": "npm run check && npm run typecheck && npm test && npm run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p functions/tsconfig.json",
    "typecheck:functions": "tsc --noEmit -p functions/tsconfig.json"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "astro": "^7.2.0",
    "echarts": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "pyodide": "^314.0.3",
    "typescript": "^6.0.3"
  }
}
