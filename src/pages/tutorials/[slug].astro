---
import Site from '../../layouts/Site.astro';
import CodeExercise from '../../components/CodeExercise.astro';
import { getCollection, render } from 'astro:content';
import { getUnit, lessons, unitIndexOfLesson, getLessonById } from '../../data/course';
import { lessonTasks } from '../../data/tasks';

export async function getStaticPaths() {
  const posts = await getCollection('tutorials');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const meta = post.data;
const unit = getUnit(meta.unitId);
const idx = unitIndexOfLesson(meta.id);
const prev = idx > 0 ? lessons[idx - 1] : undefined;
const next = idx < lessons.length - 1 ? lessons[idx + 1] : undefined;
const task = lessonTasks[meta.id];
---

<Site
  title={`${meta.title} · 单元 ${unit.number}`}
  description={meta.summary}
  sidebar
  activeUnitId={unit.id}
  activeLessonId={meta.id}
>
  <p style="margin: 0 0 0.4rem; color: var(--text-3); font-size: 0.85rem">
    单元 {unit.number} · {unit.title} — 预计 {meta.duration} 分钟
  </p>
  <h1>{meta.title}</h1>

  {meta.goals.length > 0 && (
    <div class="lesson-path">
      <div class="lesson-path-head">
        <strong>📍 本课路径</strong>
        <span class="lesson-path-meta">{meta.duration} 分钟 · {meta.goals.length} 个目标</span>
      </div>
      <ol class="lesson-path-goals">
        {meta.goals.map((g, i) => (
          <li>{g}</li>
        ))}
      </ol>
      <div class="lesson-path-rhythm">
        🎯 学习节奏:① 看目标 → ② <strong>先思考再动手</strong> → ③ 在运行器写代码 → ④ 失败时按提示重试 → ⑤ 通过后看思路
      </div>
    </div>
  )}

  <Content />

  {task && (
    <CodeExercise
      id={task.id}
      title={task.title}
      question={task.question ?? ''}
      starter={task.starter}
      check={task.check}
      hint={task.hint ?? ''}
      hintSteps={task.hintSteps ?? []}
      explanation={task.explanation ?? ''}
      skills={task.skills}
      maxScore={task.maxScore}
      recordKey="practice"
      lesson={meta.id}
    />
  )}

  {meta.practiceTarget && (
    <div class="callout tip">
      <strong>靶站实战:</strong>前往{' '}
      <a href={meta.practiceTarget} target="_blank" rel="noopener">{meta.practiceTarget}</a>{' '}
      动手练习本课内容。
    </div>
  )}

  <div class="pager">
    {prev ? (
      <a href={`/tutorials/${prev.slug}/`}>
        <span class="pager-label">← 上一课</span>
        <span class="pager-title">{prev.title}</span>
      </a>
    ) : (
      <span />
    )}
    {next ? (
      <a class="next" href={`/tutorials/${next.slug}/`}>
        <span class="pager-label">下一课 →</span>
        <span class="pager-title">{next.title}</span>
      </a>
    ) : (
      <span />
    )}
  </div>
</Site>

<div data-lesson-id={meta.id} hidden></div>

<script>
  import { store } from '../../lib/store';
  const el = document.querySelector<HTMLElement>('[data-lesson-id]');
  if (el) store.recordLessonVisit(el.getAttribute('data-lesson-id')!);
</script>
