---
import '../styles/global.css';
import { siteName, siteTagline, units, lessons } from '../data/course';

interface Props {
  title?: string;
  description?: string;
  sidebar?: boolean;
  activeUnitId?: string;
  activeLessonId?: string;
  /** 教师端内部工具不需要被搜索引擎收录 */
  noindex?: boolean;
}

const { title, description, sidebar = false, activeUnitId, activeLessonId, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${siteName}` : `${siteName} · ${siteTagline}`;
const path = Astro.url.pathname;

function navActive(prefix: string): boolean {
  return path === prefix || path.startsWith(prefix + '/');
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description ?? siteTagline} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/">
          <span class="brand-badge">爬</span>
          <span>{siteName}</span>
        </a>
        <nav class="main-nav" aria-label="主导航">
          <a href="/" class={navActive('/') && path === '/' ? 'active' : ''}>首页</a>
          <a href="/tutorials/" class={navActive('/tutorials') ? 'active' : ''}>课程目录</a>
          <a href="/practice/" class={navActive('/practice') ? 'active' : ''}>靶站</a>
          <a href="/tests/" class={navActive('/tests') ? 'active' : ''}>综合测试</a>
          <a href="/exam/" class={navActive('/exam') ? 'active' : ''}>在线考试</a>
          <a href="/mistakes/" class={navActive('/mistakes') ? 'active' : ''}>错题本</a>
          <a href="/report/" class={navActive('/report') ? 'active' : ''}>学习中心</a>
          <a
            href="/design/"
            class={`nav-teacher${navActive('/design') ? ' active' : ''}`}
            title="教师端:目标—活动—评价一致性、课时时间轴与形成性评价设计"
          >教学设计</a>
          <a
            href="/teacher/"
            class={`nav-teacher nav-teacher-secondary${navActive('/teacher') ? ' active' : ''}`}
            title="教师端:班级目标达成、共性误区与教学决策报告"
          >学情报告</a>
        </nav>

        <div class="auth-bar" id="auth-bar">
          <span class="auth-status" id="auth-status" role="status" aria-live="polite">正在检查登录状态…</span>
          <button id="auth-login" class="btn sm primary" type="button" hidden>微信登录</button>
          <div class="auth-user" id="auth-user" hidden>
            <a class="auth-account" href="/account/">我的档案</a>
            <button id="auth-copy" class="btn sm" type="button">复制 uid</button>
            <button id="auth-logout" class="btn sm" type="button">退出</button>
          </div>
        </div>
        <div class="auth-uid-box" id="auth-uid-box" hidden>
          <span>我的 uid(发给教师登记权限,不含任何隐私信息):</span>
          <code id="auth-uid"></code>
        </div>
      </div>
    </header>

    <!-- 身份状态条:未登录说明「本机记录」,已登录未绑定档案引导补全,已绑定自动隐藏。 -->
    <div class="identity-banner" id="identity-banner" role="status" aria-live="polite" hidden>
      <span id="identity-banner-text"></span>
      <a id="identity-banner-link" class="btn sm" href="/report/">了解本机记录</a>
    </div>

    <main id="main" class={sidebar ? 'layout' : 'layout single'}>
      {sidebar && (
        <aside class="sidebar">
          <div class="sidebar-section">
            <p class="sidebar-title">课程目录</p>
            {units.map((unit) => (
              <div key={unit.id}>
                {lessons
                  .filter((l) => l.unitId === unit.id)
                  .map((lesson) => (
                    <a
                      class={`sidebar-item${activeLessonId === lesson.id ? ' active' : ''}`}
                      href={`/tutorials/${lesson.slug}/`}
                    >
                      <span class="unit-label">{String(unit.number).padStart(2, '0')}.{lesson.order}</span>
                      {lesson.title}
                    </a>
                  ))}
              </div>
            ))}
          </div>
        </aside>
      )}
      <article class="content">
        <slot />
      </article>
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <span>© 2026 {siteName} · 仅供学习,请遵守 robots.txt 与相关法律法规</span>
        <span>
          不登录也能完整学习,记录默认保存在本机;微信登录后可在「我的档案」绑定身份并同步到云端 ·
          <a href="/design/">教学设计说明(教师)</a> ·
          <a href="/teacher/">学情报告(教师)</a>
        </span>
      </div>
    </footer>

    <script>
      import '../components/auth-client';
    </script>
  </body>
</html>
